msgstr ""

#: includes/class-mixmymeals-settings.php:984
msgid "Sender Address"
msgstr ""

#: includes/class-mixmymeals-settings.php:985
msgid "From address for outgoing e-mails. Leave empty to use no-reply@your-domain."
msgstr ""

