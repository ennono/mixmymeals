msgid "Appended Text Block"
msgstr ""

#: includes/class-mixmymeals-settings.php:1121
msgid "HTML or plain text. Each sending rule whose “Append” box is ticked adds this block to the end of its e-mail."
msgstr ""

#: includes/class-mixmymeals-settings.php:1129
msgid "Privacy & retention"
msgstr ""

