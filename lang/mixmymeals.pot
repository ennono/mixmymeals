msgid "Notice text"
msgstr ""

#: includes/class-mixmymeals-settings.php:901
msgid "Shown under the e-mail field. Links are allowed (<a href=\"…\">). Leave empty for the standard consent sentence, which links the privacy page set in the E-Mail & Subscriptions tab."
msgstr ""

