msgid "Activation"
msgstr ""

#: includes/class-mixmymeals-settings.php:1003
msgid "Enable Subscriptions"
msgstr ""

#: includes/class-mixmymeals-settings.php:1004
msgid "Allow visitors to subscribe to meal plans and run the sending schedule."
msgstr ""

