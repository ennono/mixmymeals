#: includes/class-mixmymeals-settings.php:547
msgid "MixMyMeals"
msgstr "MixMyMeals"

#. Description of the plugin
#: mixmymeals.php
msgid "Plan your meals."
msgstr "Plane deine Mahlzeiten."

#. Author of the plugin
#: mixmymeals.php
msgid "Timo Fricke"
msgstr ""

#: includes/class-mixmymeals-settings.php:126
msgid "General Settings"
msgstr "Allgemeine Einstellungen"

#: includes/class-mixmymeals-settings.php:127
msgid "Setup general things."
msgstr "Konfiguriere Allgemeines."

#: includes/class-mixmymeals-settings.php:132
msgid "Currency"
msgstr "Währung"

#: includes/class-mixmymeals-settings.php:133
msgid "Currency symbol used for price display."
msgstr "Währungssymbol für die Preisanzeige."

#: includes/class-mixmymeals-settings.php:140
msgid "Public Mode"
msgstr "Öffentlicher Modus"

#: includes/class-mixmymeals-settings.php:141
msgid "Allow every visitor to publish plans."
msgstr "Erlaube jedem jedem Besucher, Pläne zu veröffentlichen."

#: includes/class-mixmymeals-settings.php:151
msgid "Meal Plans per Hour"
msgstr "Pläne pro Stunde"

#: includes/class-mixmymeals-settings.php:152
msgid "How many plans should a visitor be allowed to publish per hour?"
msgstr "Wie viele Pläne soll ein Besucher pro Stunde veröffentlichen dürfen?"

#: includes/class-mixmymeals-settings.php:162
msgid "Set visitor plans to draft"
msgstr "Setze Besucherpläne auf Entwurf"

#: includes/class-mixmymeals-settings.php:163
msgid "Save visitor plans as drafts."
msgstr "Pläne von Besuchern als Entwürfe speichern."

#: includes/class-mixmymeals-settings.php:173
msgid "Altervative Redirect"
msgstr "Alternative Umleitung"

#: includes/class-mixmymeals-settings.php:174
msgid "Where to send vistors after new plan has been saved as draft."
msgstr ""
"Wohin Besucher nach dem Speichern einen Plans weitergeleitet werden sollen."

#: includes/class-mixmymeals-settings.php:184
msgid "Placeholder Image"
msgstr "Platzhalterbild"

#: includes/class-mixmymeals-settings.php:185
msgid "Choose an image to show if there is no recipe image."
msgstr ""
"Wähle ein Bild, das angezeigt wird, wenn kein Rezeptbild vorhanden ist."

