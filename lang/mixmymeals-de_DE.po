msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#: includes/lib/class-mixmymeals-meal-plan.php
msgid ""
"Compared with the daily reference intake of an average adult (2 000 kcal); "
"your own needs may differ."
msgstr ""
"Verglichen mit der Referenzmenge pro Tag für einen durchschnittlichen "
"Erwachsenen (2 000 kcal); dein Bedarf kann abweichen."

#: includes/lib/class-mixmymeals-meal-plan.php
#, php-format
msgid "\"Too much\" means more than %s."
msgstr "„Zu viel“ heißt: mehr als %s."

#: includes/lib/class-mixmymeals-meal-plan.php
#, php-format
msgid ""
"\"Too little\" means less than %s and only appears for days with breakfast, "
"lunch and dinner."
msgstr ""
"„Zu wenig“ heißt: weniger als %s – nur bei Tagen mit Frühstück, Mittag- und "
"Abendessen."

