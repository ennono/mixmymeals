msgstr "Regeln:"

#: includes/lib/class-mixmymeals-importer.php:318
msgid "One object per ingredient"
msgstr "Ein Objekt pro Zutat"

#: includes/lib/class-mixmymeals-importer.php:319
msgid "Include nutritional values per 100g if available: calories, fat, carbs, protein, sugar, fiber, salt — use 0 if unknown"
msgstr "Nährwerte pro 100g wenn vorhanden: Kalorien, Fett, Kohlenhydrate, Eiweiß, Zucker, Ballaststoffe, Salz – bei unbekannt 0 eintragen"

#: includes/lib/class-mixmymeals-importer.php:320
msgid "Include price_per_100g if a typical retail price is known; omit the field if unknown"
msgstr "price_per_100g angeben, wenn ein typischer Marktpreis bekannt ist; Feld weglassen, wenn unbekannt"

#: includes/lib/class-mixmymeals-importer.php:321
msgid "List all common units with their weight in grams (e.g. piece, package, can)"
msgstr "Alle gängigen Einheiten mit Gewicht in Gramm auflisten (z. B. Stück, Packung, Dose)"

#: includes/lib/class-mixmymeals-importer.php:322
msgid "Output: only the JSON array, no additional text"
msgstr "Ausgabe: nur das JSON-Array, kein weiterer Text"

