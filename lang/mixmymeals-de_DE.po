#: includes/lib/class-mixmymeals-shortcodes.php:2859
msgid "Ingredients"
msgstr "Zutaten"

#: includes/class-mixmymeals-settings.php:255
msgid "Setup ingredients."
msgstr "Zutaten einrichten."

#: includes/class-mixmymeals-settings.php:259
msgid "Ingredient Archive Description"
msgstr "Archivbeschreibung für Zutaten"

#: includes/class-mixmymeals-settings.php:273
#: includes/lib/class-mixmymeals-post-types.php:352
#: includes/lib/class-mixmymeals-post-types.php:357
#: includes/lib/class-mixmymeals-post-types.php:658
#: includes/lib/class-mixmymeals-shortcodes.php:3515
msgid "Meals"
msgstr "Mahlzeiten"

#: includes/class-mixmymeals-settings.php:274
msgid "Setup meals."
msgstr "Konfiguriere Mahlzeiten."

#: includes/class-mixmymeals-settings.php:279
msgid "Meal Slug"
msgstr "Mahlzeit-Slug"

#: includes/class-mixmymeals-settings.php:280
msgid "Set the prefix for meals in the URL."
msgstr "Setze das Präfix für Mahlzeiten in der URL."

#: includes/class-mixmymeals-settings.php:293
#: includes/lib/class-mixmymeals-post-types.php:318
#: includes/lib/class-mixmymeals-post-types.php:323
msgid "Meal Plans"
msgstr "Essenspläne"

#: includes/class-mixmymeals-settings.php:294
msgid "Setup meal plans."
msgstr "Konfiguriere Essenspläne."

#: includes/class-mixmymeals-settings.php:299
msgid "Meal Plan Slug"
msgstr "Essensplan-Slug"

#: includes/class-mixmymeals-settings.php:300
msgid "Set the prefix for meal plans in the URL."
msgstr "Setze das Präfix für Essenspläne in der URL."

#: includes/class-mixmymeals-settings.php:311
msgid "Meal Plan Category Slug"
msgstr "Essensplan Kategorie-Slug"

#: includes/class-mixmymeals-settings.php:312
msgid "Set the prefix for meal plan categories in the URL."
msgstr "Setze das Präfix für Essensplankategorien in der URL."

#: includes/class-mixmymeals-settings.php:323
msgid "Max. meals in planner"
msgstr "Max. Mahlzeiten im Planer"

#: includes/class-mixmymeals-settings.php:324
msgid "How many meals should be allowed in the planner?"
msgstr "Wie viele Mahlzeiten sollen im Planer erlaubt sein?"

#: includes/class-mixmymeals-settings.php:335
msgid "Individual Tab Label"
msgstr "Bezeichnung für den Individuell-Tab"

#: includes/class-mixmymeals-settings.php:336
msgid "Label for the \"Individual\" tab in the meal plan switcher."
msgstr "Bezeichnung für den „Individuell“-Tab im Essensplan-Umschalter."

#: includes/class-mixmymeals-settings.php:339
#: includes/lib/class-mixmymeals-shortcodes.php:4639
msgid "Individual"
msgstr "Individuell"

#: includes/class-mixmymeals-settings.php:347
msgid "Meal Plan Archive Description"
msgstr "Archivbeschreibung für Essenspläne"

#: includes/class-mixmymeals-settings.php:359
msgid "Individual Meal Plans Description"
msgstr "Beschreibung für individuelle Essenspläne"

#: includes/class-mixmymeals-settings.php:371
msgid "Enable Cleanup"
msgstr "Aufräumen aktivieren"

#: includes/class-mixmymeals-settings.php:372
msgid ""
"Automatically delete orphaned meals and old meal plans without a category "
"once per day."
msgstr ""
"Verwaiste Mahlzeiten und alte Mahlzeitenpläne ohne Kategorie einmal täglich "
"automatisch löschen."

#: includes/class-mixmymeals-settings.php:383
msgid "Cleanup Minimum Age"
msgstr "Mindestalter für das Aufräumen"

#: includes/class-mixmymeals-settings.php:384
msgid "Only delete items older than this many days."
msgstr "Nur Einträge löschen, die älter als diese Anzahl Tage sind."

#: includes/class-mixmymeals-settings.php:395
msgid "Cleanup Report"
msgstr "Aufräum-Bericht"

#: includes/class-mixmymeals-settings.php:396
msgid ""
"E-mail a summary after each cleanup run (only when something was deleted)."
msgstr ""
"Nach jedem Aufräumlauf eine Zusammenfassung per E-Mail senden (nur wenn "
"etwas gelöscht wurde).Nach jedem Aufräumlauf eine Zusammenfassung per E-Mail "
"senden (nur wenn etwas gelöscht wurde)."

#: includes/class-mixmymeals-settings.php:407
msgid "Report Recipient"
msgstr "Berichtsempfänger"

#: includes/class-mixmymeals-settings.php:408
msgid ""
"Address the cleanup report is sent to. Leave empty to use the site admin e-"
"mail."
msgstr ""
"Adresse, an die der Aufräum-Bericht gesendet wird. Leer lassen, um die Admin-"
"E-Mail der Seite zu verwenden.Adresse, an die der Aufräum-Bericht gesendet "
"wird. Leer lassen, um die Admin-E-Mail der Seite zu verwenden."

#: includes/class-mixmymeals-settings.php:421
msgid "E-Mail"
msgstr "E-Mail"

#: includes/class-mixmymeals-settings.php:422
msgid "Sender identity and privacy options for e-mails sent by the plugin."
msgstr ""
"Absenderidentität und Datenschutz-Optionen für E-Mails, die das Plugin "
"versendet.Absenderidentität und Datenschutz-Optionen für E-Mails, die das "
"Plugin versendet."

#: includes/class-mixmymeals-settings.php:427
msgid "Sender Name"
msgstr "Absendername"

#: includes/class-mixmymeals-settings.php:428
msgid "Name shown as the e-mail sender. Defaults to the site title."
msgstr "Name, der als Absender angezeigt wird. Standard ist der Seitentitel."

#: includes/class-mixmymeals-settings.php:436
msgid "Sender Address"
msgstr "Absenderadresse"

#: includes/class-mixmymeals-settings.php:437
msgid ""
"From address for outgoing e-mails. Leave empty to use no-reply@your-domain."
msgstr ""
"Absenderadresse für ausgehende E-Mails. Leer lassen, um no-reply@deine-"
"domain zu verwenden.Absenderadresse für ausgehende E-Mails. Leer lassen, um "
"no-reply@deine-domain zu verwenden."

#: includes/class-mixmymeals-settings.php:448
msgid "E-Mail Footer"
msgstr "E-Mail-Fußzeile"

#: includes/class-mixmymeals-settings.php:449
msgid ""
"Footer added to e-mails (e.g. imprint, data controller, opt-out note). HTML "
"allowed."
msgstr ""
"Fußzeile, die an E-Mails angehängt wird (z. B. Impressum, Verantwortlicher, "
"Abmeldehinweis). HTML erlaubt.Fußzeile, die an E-Mails angehängt wird (z. B. "
"Impressum, Verantwortlicher, Abmeldehinweis). HTML erlaubt."

#: includes/class-mixmymeals-settings.php:460
msgid "Suppression List"
msgstr "Sperrliste"

#: includes/class-mixmymeals-settings.php:461
msgid ""
"Opted-out addresses, one per line. These never receive non-transactional e-"
"mails."
msgstr ""
"Abgemeldete Adressen, eine pro Zeile. Diese erhalten keine nicht-"
"transaktionalen E-Mails.Abgemeldete Adressen, eine pro Zeile. Diese erhalten "
"keine nicht-transaktionalen E-Mails."

#: includes/class-mixmymeals-settings.php:472
msgid "Send Log"
msgstr "Sendeprotokoll"

#: includes/class-mixmymeals-settings.php:473
msgid ""
"Keep a log of sent e-mails (recipient, subject, status — no message content)."
msgstr ""
"Ein Protokoll versendeter E-Mails führen (Empfänger, Betreff, Status – keine "
"Inhalte).Ein Protokoll versendeter E-Mails führen (Empfänger, Betreff, "
"Status – keine Inhalte)."

#: includes/class-mixmymeals-settings.php:486
#: includes/lib/class-mixmymeals-subscriptions.php:171
#: includes/lib/class-mixmymeals-subscriptions.php:173
msgid "Subscriptions"
msgstr "Abos"

#: includes/class-mixmymeals-settings.php:487
msgid ""
"Let visitors subscribe to a meal plan and receive day e-mails (double opt-"
"in)."
msgstr ""
"Besucher können einen Essensplan abonnieren und Tages-E-Mails erhalten "
"(Double-Opt-in)."

#: includes/class-mixmymeals-settings.php:492
msgid "Enable Subscriptions"
msgstr "Abos aktivieren"

#: includes/class-mixmymeals-settings.php:493
msgid "Allow visitors to subscribe to meal plans and run the sending schedule."
msgstr ""
"Besuchern erlauben, Essenspläne zu abonnieren, und den Versandzeitplan "
"ausführen."

#: includes/class-mixmymeals-settings.php:501
msgid "Sending Schedule"
msgstr "Versandzeitplan"

#: includes/class-mixmymeals-settings.php:502
msgid ""
"Global plan: which template goes out on which weekday and time. The content "
"adapts to the subscribed plan; only weekdays that are part of a plan are "
"sent."
msgstr ""
"Globaler Plan: welche Vorlage an welchem Wochentag und zu welcher Uhrzeit "
"rausgeht. Der Inhalt richtet sich nach dem abonnierten Plan; nur Wochentage, "
"die zum Plan gehören, werden versendet."

#: includes/class-mixmymeals-settings.php:510
msgid "Privacy Policy URL"
msgstr "URL der Datenschutzerklärung"

#: includes/class-mixmymeals-settings.php:511
msgid "Linked from the consent checkbox on the subscribe form."
msgstr "Wird von der Einwilligungs-Checkbox im Anmeldeformular verlinkt."

#: includes/class-mixmymeals-settings.php:519
msgid "Confirmation Window (hours)"
msgstr "Bestätigungsfenster (Stunden)"

#: includes/class-mixmymeals-settings.php:520
msgid "Unconfirmed subscriptions are deleted after this many hours."
msgstr "Unbestätigte Abos werden nach so vielen Stunden gelöscht."

#: includes/class-mixmymeals-settings.php:528
msgid "Retention (days)"
msgstr "Aufbewahrung (Tage)"

#: includes/class-mixmymeals-settings.php:529
msgid "Completed/unsubscribed records are deleted after this many days."
msgstr ""
"Abgeschlossene/abgemeldete Einträge werden nach so vielen Tagen gelöscht."

#: includes/class-mixmymeals-settings.php:537
msgid "Store Consent IP"
msgstr "Einwilligungs-IP speichern"

#: includes/class-mixmymeals-settings.php:538
msgid "Also store the IP address as part of the consent record (optional)."
msgstr ""
"Zusätzlich die IP-Adresse als Teil des Einwilligungsnachweises speichern "
"(optional)."

#: includes/class-mixmymeals-settings.php:648
#: includes/class-mixmymeals-settings.php:753
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-mixmymeals-settings.php:836
msgid "Save Settings"
msgstr "Einstellungen speichern"

#: includes/class-mixmymeals-settings.php:868
msgid "Send a test e-mail"
msgstr "Test-E-Mail senden"

#: includes/class-mixmymeals-settings.php:870
msgid ""
"Sends a test message with the current sender settings. Save your changes "
"first."
msgstr ""
"Sendet eine Testnachricht mit den aktuellen Absendereinstellungen. Bitte "
"zuerst speichern.Sendet eine Testnachricht mit den aktuellen "
"Absendereinstellungen. Bitte zuerst speichern."

#: includes/class-mixmymeals-settings.php:877
msgid "Send test e-mail"
msgstr "Test-E-Mail senden"

#: includes/class-mixmymeals-settings.php:896
#: includes/class-mixmymeals-settings.php:1054
msgid "You are not allowed to do this."
msgstr "Dazu bist du nicht berechtigt."

#: includes/class-mixmymeals-settings.php:905
msgid "The mailer is not available."
msgstr "Der Mailer ist nicht verfügbar."

#: includes/class-mixmymeals-settings.php:921
msgid "Test e-mail"
msgstr "Test-E-Mail"

#. translators: %s: site name.
#: includes/class-mixmymeals-settings.php:925
#, php-format
msgid "This is a test message from %s."
msgstr "Dies ist eine Testnachricht von %s."

#. translators: %s: date and time the test was sent.
#: includes/class-mixmymeals-settings.php:932
#, php-format
msgid "Sent on %s. If you can read this, the mailer is working."
msgstr "Gesendet am %s. Wenn du das lesen kannst, funktioniert der Mailer."

#. translators: %s: site name.
#: includes/class-mixmymeals-settings.php:939
#, php-format
msgid "[%s] Test e-mail"
msgstr "[%s] Test-E-Mail"

#. translators: %s: recipient e-mail address.
#: includes/class-mixmymeals-settings.php:960
#, php-format
msgid "Test e-mail sent to %s."
msgstr "Test-E-Mail an %s gesendet."

#: includes/class-mixmymeals-settings.php:967
msgid ""
"wp_mail() reported a failure. Please check your server / SMTP configuration."
msgstr ""
"wp_mail() hat einen Fehler gemeldet. Bitte prüfe deine Server- bzw. SMTP-"
"Konfiguration.wp_mail() hat einen Fehler gemeldet. Bitte prüfe deine Server- "
"bzw. SMTP-Konfiguration."

#: includes/class-mixmymeals-settings.php:987
msgid "Send log"
msgstr "Sendeprotokoll"

#: includes/class-mixmymeals-settings.php:991
msgid ""
"Logging is currently disabled. Enable “Send Log” above and save to start "
"recording."
msgstr ""
"Die Protokollierung ist derzeit deaktiviert. Aktiviere oben das "
"Sendeprotokoll und speichere, um aufzuzeichnen.Die Protokollierung ist "
"derzeit deaktiviert. Aktiviere oben das Sendeprotokoll und speichere, um "
"aufzuzeichnen."

#: includes/class-mixmymeals-settings.php:997
msgid "No e-mails logged yet."
msgstr "Noch keine E-Mails protokolliert."

