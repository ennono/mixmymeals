msgstr "Protokoll leeren"

#: includes/class-mixmymeals-settings.php:1003
msgid "Send log cleared."
msgstr "Sendeprotokoll geleert."

#: includes/class-mixmymeals-settings.php:1015
msgid "Cloning of Mixmymeals_API is forbidden."
msgstr "Das Klonen der MixMyMeals_API ist verboten."

#: includes/class-mixmymeals-settings.php:1033
msgid "Unserializing instances of Mixmymeals_API is forbidden."
msgstr "Das Deserialisieren der MixMyMeals_API-Instanzen ist verboten."

