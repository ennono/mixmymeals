#~ msgid ""
#~ "This site uses the MixMyMeals plugin. Everything below is processed within "
#~ "this website itself — that is, on the hosting described elsewhere in this "
#~ "policy. The plugin calls no service of its own and passes no visitor data to"
#~ " anyone else."
#~ msgstr ""
